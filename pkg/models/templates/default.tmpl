{{- end }}

{{- define "__subject" -}}
{{- if eq .Status "firing" }}🚨 告警中{{ else }}✅ 已恢复{{ end -}}
{{- if .Signature }} 【{{ .Signature }}】{{ end -}}
{{- if .Alerts }}{{ template "__severity" (index .Alerts 0) }}{{ end -}}
{{- ` · ` -}}
{{- if .CommonLabels.alertname }}{{ .CommonLabels.alertname }}{{ else if .GroupLabels.alertname }}{{ .GroupLabels.alertname }}{{ else if .Alerts }}{{ (index .Alerts 0).Labels.alertname }}{{ else }}告警{{ end -}}
{{- end }}

{{- define "__alert_instance" -}}
{{- if .Labels.alertinstance }}{{ .Labels.alertinstance }}{{ else if .Labels.instance }}{{ .Labels.instance }}{{ else if .Labels.node }}{{ .Labels.node }}{{ else if .Labels.host }}{{ .Labels.host }}{{ else if .Labels.hostname }}{{ .Labels.hostname }}{{ else if .Labels.ip }}{{ .Labels.ip }}{{ end -}}
{{- end }}

{{- define "prom.title" -}}
{{ template "__subject" . }}{{ end }}

{{- define "prom.markdown" }}
{{ template "__subject" . }}

{{- if eq .Status "firing" }}> 🔥 共 **{{ .Alerts.Firing|len }}** 个告警触发{{ else }}> ✅ 以下 **{{ .Alerts.Resolved|len }}** 个告警已恢复{{ end }}

{{- if gt (.Alerts.Firing|len) 0 }}
### 🚨 告警明细

{{- range .Alerts.Firing }}
- **{{ .Labels.alertname }}**（{{ template "__severity" . }}）
  - 实例：`{{ template "__alert_instance" . }}`
  - 状态：`{{ .Status | toUpper }}` · 开始：{{ .StartsAt.Format "2006-01-02 15:04:05" }}
  - 描述：{{ .Annotations.summary }}
{{- if .Annotations.description }}
  - 详情：{{ .Annotations.description }}
{{- end }}
{{- end }}
{{- end }}

{{- if gt (.Alerts.Resolved|len) 0 }}
### ✅ 恢复明细

{{- range .Alerts.Resolved }}
- **{{ .Labels.alertname }}**（{{ template "__severity" . }}）
  - 实例：`{{ template "__alert_instance" . }}`
  - 恢复：{{ .EndsAt.Format "2006-01-02 15:04:05" }}
  - 描述：{{ .Annotations.summary }}
{{- end }}
{{- end }}

